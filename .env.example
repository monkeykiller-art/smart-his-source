# Copy to .env and set secure values before starting Docker Compose.
POSTGRES_PASSWORD=
# Optional; local startup defaults the application database password to POSTGRES_PASSWORD.
DB_USER=his
DB_PASSWORD=
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=
# Base64-encoded key with at least 256 bits, shared by gateway and auth service.
HIS_JWT_SECRET=
